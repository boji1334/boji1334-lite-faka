[Unit]
Description=Boji1334 Lite Faka
After=network.target

[Service]
Type=simple
User=litefaka
WorkingDirectory=/opt/boji1334-lite-faka
EnvironmentFile=/etc/boji1334-lite-faka.env
ExecStart=/usr/bin/python3 /opt/boji1334-lite-faka/app.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/boji1334-lite-faka/data
MemoryMax=128M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
